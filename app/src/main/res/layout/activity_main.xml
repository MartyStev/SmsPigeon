<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grad">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textColor="@color/ink_muted"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_status"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switch_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forwarding_enabled"
                android:textColor="@color/ink"
                android:paddingTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_bot"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/token"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/input_chat_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/chat_id"
                android:inputType="text"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_sim"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_sim1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/sim1_name"
                android:inputType="text"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/input_sim2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/sim2_name"
                android:inputType="text"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/group_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/mode_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_all"
                    android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/mode_whitelist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_blacklist"
                android:textColor="@color/ink" />
            </RadioGroup>

            <EditText
                android:id="@+id/input_whitelist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/blacklist_hint"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:textColor="@color/white"
            android:background="@drawable/bg_button"
            android:padding="14dp"
            android:layout_marginBottom="20dp" />
    </LinearLayout>
</ScrollView>
